diff --git a/src/core/quick-add.ts b/src/core/quick-add.ts
new file mode 100644
index 00000000..ef04fb72
--- /dev/null
+++ b/src/core/quick-add.ts
@@ -0,0 +1,78 @@
+import type { DueDay, Recurrence, TaskFields, TaskPriority } from "./tasks.js";
+
+/**
+ * The quick-add parser (design 02-tasks, issue #606): `factory task add <words>` picks these tokens out of the
+ * words, in any order, and the words left are the title:
+ * - `today`, `tomorrow`, `YYYY-MM-DD`: the due day (today and tomorrow are resolved later, by the store's Clock);
+ * - `HH:MM`: the due time, 24-hour (alone: due today);
+ * - `!1` to `!3`: the priority, 1 the highest;
+ * - `#label`: the list;
+ * - `every day`, `every week`, `every month`: the recurrence, which needs a due day.
+ * Each field at most once. Pure: no clock, no I/O.
+ */
+
+export type QuickAddResult = { ok: true; task: TaskFields } | { ok: false; reason: string };
+
+const RECURRENCES: readonly Recurrence[] = ["day", "week", "month"];
+
+/** A real calendar date, `YYYY-MM-DD`. */
+function validDate(s: string): boolean {
+  const [y, m, d] = s.split("-").map(Number) as [number, number, number];
+  const t = new Date(Date.UTC(y, m - 1, d));
+  return t.getUTCFullYear() === y && t.getUTCMonth() === m - 1 && t.getUTCDate() === d;
+}
+
+export function parseQuickAdd(words: string): QuickAddResult {
+  const tokens = words.trim().split(/\s+/).filter((w) => w !== "");
+  const title: string[] = [];
+  let due: DueDay | null = null;
+  let due_time: string | null = null;
+  let priority: TaskPriority | null = null;
+  let list: string | null = null;
+  let recurrence: Recurrence | null = null;
+  const seen = new Set<string>();
+  const once = (field: string): string | null => {
+    if (seen.has(field)) return `repeated field: ${field} given twice`;
+    seen.add(field);
+    return null;
+  };
+  for (let i = 0; i < tokens.length; i++) {
+    const w = tokens[i]!;
+    const lower = w.toLowerCase();
+    let refused: string | null = null;
+    if (lower === "today" || lower === "tomorrow") {
+      refused = once("due date");
+      due = { days_from_today: lower === "today" ? 0 : 1 };
+    } else if (/^\d{4}-\d{2}-\d{2}$/.test(w)) {
+      if (!validDate(w)) return { ok: false, reason: `not a date: ${w}` };
+      refused = once("due date");
+      due = { date: w };
+    } else if (/^\d{1,2}:\d{2}$/.test(w)) {
+      const [h, m] = w.split(":").map(Number) as [number, number];
+      if (h > 23 || m > 59) return { ok: false, reason: `not a time: ${w}` };
+      refused = once("due time");
+      due_time = `${String(h).padStart(2, "0")}:${String(m).padStart(2, "0")}`;
+    } else if (/^!\d+$/.test(w)) {
+      const p = Number(w.slice(1));
+      if (p < 1 || p > 3) return { ok: false, reason: `priority must be !1, !2 or !3, not ${w}` };
+      refused = once("priority");
+      priority = p as TaskPriority;
+    } else if (/^#[\w-]+$/.test(w)) {
+      refused = once("list");
+      list = w.slice(1);
+    } else if (lower === "every") {
+      const next = tokens[i + 1]?.toLowerCase();
+      if (next === undefined || !(RECURRENCES as readonly string[]).includes(next)) {
+        return { ok: false, reason: `unknown recurrence: every ${next ?? ""}`.trim() + " (use every day, every week or every month)" };
+      }
+      refused = once("recurrence");
+      recurrence = next as Recurrence;
+      i++;
+    } else title.push(w);
+    if (refused !== null) return { ok: false, reason: refused };
+  }
+  if (title.length === 0) return { ok: false, reason: "the title is empty: give some words besides the quick-add tokens" };
+  if (due === null && due_time !== null) due = { days_from_today: 0 };
+  if (recurrence !== null && due === null) return { ok: false, reason: `every ${recurrence} needs a due date (today, tomorrow or YYYY-MM-DD)` };
+  return { ok: true, task: { title: title.join(" "), list, priority, due, due_time, recurrence } };
+}
diff --git a/src/core/tasks.ts b/src/core/tasks.ts
new file mode 100644
index 00000000..64b9a14c
--- /dev/null
+++ b/src/core/tasks.ts
@@ -0,0 +1,88 @@
+import type { Timestamp, UserId } from "./types.js";
+
+/**
+ * Plain tasks (design 02-tasks, issue #606): a to-do the owner keeps beside the work items, stored in
+ * `controller_tasks`, never a work item, so triage never reads one. No repository: `list` is a free label.
+ */
+
+export type Recurrence = "day" | "week" | "month";
+export type TaskPriority = 1 | 2 | 3;
+
+/** A due day as typed: a calendar date, or today/tomorrow, which the store resolves with its injected Clock. */
+export type DueDay = { date: string } | { days_from_today: 0 | 1 };
+
+/** What quick-add words say about a task (src/core/quick-add.ts). */
+export interface TaskFields {
+  title: string;
+  /** A free `#label`, without the `#`; never a repository key. */
+  list: string | null;
+  /** 1 is the highest. */
+  priority: TaskPriority | null;
+  due: DueDay | null;
+  /** `HH:MM`, 24-hour. */
+  due_time: string | null;
+  recurrence: Recurrence | null;
+}
+
+export interface NewTask extends TaskFields {
+  /** Chosen by the caller, so a repeated add (a retry, a redelivered chat message) stores nothing more. */
+  id: string;
+  /** The CLI user's ID from the environment, never a display name. */
+  created_by: UserId;
+}
+
+export interface Task extends Omit<TaskFields, "due"> {
+  id: string;
+  /** `YYYY-MM-DD`, or null. */
+  due_date: string | null;
+  created_by: UserId;
+  created_at: Timestamp;
+  done_at: Timestamp | null;
+  /** The task a recurring occurrence came from; null for a task someone added. */
+  parent_id: string | null;
+}
+
+export type CompleteTaskResult =
+  | { ok: false; reason: "not_found" }
+  /** `completed`: false when it was already done (nothing written). `next`: the stored next occurrence of a recurring task. */
+  | { ok: true; task: Task; completed: boolean; next: Task | null };
+
+/** The store's task methods, part of FactoryStore; implemented once in the shared SQL store. */
+export interface TaskStore {
+  /** Inserts the task unless its ID is stored; returns the stored row either way. */
+  addTask(t: NewTask): Promise<Task>;
+  /** Open tasks (no done_at), oldest first, at most `limit`. Read-only. */
+  listTasks(limit: number): Promise<Task[]>;
+  /**
+   * Sets done_at, conditional on it being unset, and for a recurring task inserts its next occurrence (parent_id
+   * this task, unique) in the same transaction, so a second completion writes nothing.
+   */
+  completeTask(id: string): Promise<CompleteTaskResult>;
+}
+
+const pad = (n: number) => String(n).padStart(2, "0");
+
+/** The calendar date of `now` in this process's time zone, `YYYY-MM-DD`; `days` later when given. */
+export function localDate(now: Date, days = 0): string {
+  const d = new Date(now.getFullYear(), now.getMonth(), now.getDate() + days);
+  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
+}
+
+/** The next occurrence's due date: a day or a week later, or a month later on the same day (the month's last day when shorter). */
+export function nextDueDate(date: string, every: Recurrence): string {
+  const [y, m, d] = date.split("-").map(Number) as [number, number, number];
+  if (every !== "month") {
+    const next = new Date(Date.UTC(y, m - 1, d + (every === "day" ? 1 : 7)));
+    return next.toISOString().slice(0, 10);
+  }
+  const last = new Date(Date.UTC(y, m + 1, 0)).getUTCDate();
+  const next = new Date(Date.UTC(y, m, Math.min(d, last)));
+  return next.toISOString().slice(0, 10);
+}
+
+/** One line per task: ID, title, due, priority, list (as `#label`) and recurrence, `-` for each unset. */
+export function taskLine(t: Task): string {
+  const due = t.due_date === null ? "-" : t.due_time === null ? t.due_date : `${t.due_date} ${t.due_time}`;
+  const list = t.list === null ? "-" : "#" + t.list;
+  return [t.id, t.title, due, t.priority === null ? "-" : `!${t.priority}`, list, t.recurrence === null ? "-" : `every ${t.recurrence}`].join("\t");
+}
