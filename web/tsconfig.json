{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["src", "vite.config.ts", "../tests/ui-shell.test.tsx", "../tests/ui-shell-fixtures.tsx", "../tests/ui-shell-pages.test.tsx", "../tests/ui-shell-revisions.test.tsx", "../tests/ui-shell-items.test.tsx", "../tests/ui-shell-commands.test.tsx", "../tests/ui-shell-needs.test.tsx"]
}
