# Template for the factory's secret file. Do NOT fill this in here.
# Copy it OUTSIDE the repository and fill in the copy:
#   mkdir -p ~/.config/software-factory && chmod 700 ~/.config/software-factory
#   cp .env.example ~/.config/software-factory/.env && chmod 600 ~/.config/software-factory/.env
# Full guide: docs/setup.md

# Model credential: from `claude setup-token` (Claude subscription).
# Leave ANTHROPIC_API_KEY empty unless you use an API key instead.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=

# GitHub fine-grained token, scoped to the one repository the factory works on.
GITHUB_TOKEN=

# GitHub App mode only (plugins.github_auth "app"): the App ID, a plain setting. The key goes in github-app.pem next to this file.
GITHUB_APP_ID=

# Slack source only (plugins.source lists "slack"): the app-level token (xapp-, Socket Mode) and the bot token (xoxb-). docs/slack-setup.md
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=
