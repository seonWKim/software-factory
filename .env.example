# Copy to .env and fill in. .env is gitignored; this file is committed.

# Claude Code headless on your subscription (from `claude setup-token`).
# Leave ANTHROPIC_API_KEY unset locally: if present it overrides the subscription login.
CLAUDE_CODE_OAUTH_TOKEN=

# GitHub access for intake (issues), PRs and reviews. A fine-grained token scoped to this repo.
GITHUB_TOKEN=
