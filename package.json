{
  "name": "software-factory",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.test.json && tsc -p web/tsconfig.json",
    "test": "vitest run --configLoader runner",
    "test:mysql": "SF_TEST_MYSQL_URL=$(cat .factory/test-mysql.url) vitest run --configLoader runner",
    "factory": "npm run --silent build && node --disable-warning=ExperimentalWarning dist/main.js",
    "migrate": "npm run --silent build && node --disable-warning=ExperimentalWarning dist/main.js migrate",
    "setup": "npm install --silent && npm run --silent build && node --disable-warning=ExperimentalWarning dist/main.js setup",
    "schema:snapshot": "SF_SNAPSHOT_UPDATE=1 vitest run --configLoader runner tests/architecture/schema-snapshot.test.ts"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "axe-core": "4.14.0",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^4.1.12"
  },
  "bin": {
    "factory": "dist/main.js"
  },
  "dependencies": {
    "mysql2": "^3.24.6",
    "react-aria-components": "1.22.1"
  }
}
