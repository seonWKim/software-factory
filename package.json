{
  "name": "software-factory",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:mysql": "SF_TEST_MYSQL_URL=$(cat .factory/test-mysql.url) vitest run",
    "factory": "tsc -p tsconfig.json && node --disable-warning=ExperimentalWarning dist/main.js",
    "setup": "npm install --silent && tsc -p tsconfig.json && node --disable-warning=ExperimentalWarning dist/main.js setup"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "bin": {
    "factory": "dist/main.js"
  },
  "dependencies": {
    "mysql2": "^3.24.6"
  }
}
