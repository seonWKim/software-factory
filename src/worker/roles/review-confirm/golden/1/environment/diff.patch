+/** `items` in chunks of at most `size`, in order. */
+export function chunks<T>(items: readonly T[], size: number): T[][] {
+  const out: T[][] = [];
+  for (let i = 0; i + size < items.length; i += size) {
+    out.push(items.slice(i, i + size));
+  }
+  return out;
+}
