{
  "display_information": {
    "name": "Gongbang",
    "background_color": "#1C1C1E",
    "description": "Turns Slack threads into work items and talks through them in the thread."
  },
  "features": {
    "bot_user": { "display_name": "gongbang", "always_online": true }
  },
  "oauth_config": {
    "scopes": {
      "bot": ["app_mentions:read", "channels:history", "groups:history", "chat:write", "im:write", "reactions:read", "reactions:write"]
    }
  },
  "settings": {
    "event_subscriptions": { "bot_events": ["app_mention", "message.channels", "message.groups", "reaction_added"] },
    "interactivity": { "is_enabled": true },
    "socket_mode_enabled": true,
    "org_deploy_enabled": false,
    "token_rotation_enabled": false
  }
}
