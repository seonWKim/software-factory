{
  "display_information": {
    "name": "Software Factory",
    "description": "Turns Slack threads into work items and talks through them in the thread."
  },
  "features": {
    "bot_user": { "display_name": "software-factory", "always_online": true }
  },
  "oauth_config": {
    "scopes": {
      "bot": ["app_mentions:read", "channels:history", "chat:write"]
    }
  },
  "settings": {
    "event_subscriptions": { "bot_events": ["app_mention", "message.channels"] },
    "interactivity": { "is_enabled": true },
    "socket_mode_enabled": true,
    "org_deploy_enabled": false,
    "token_rotation_enabled": false
  }
}
