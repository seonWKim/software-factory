{
  "env": "local",
  "store": { "type": "mysql", "host": "localhost", "port": 3306, "database": "software_factory", "user": "factory" },
  "repo": {
    "owner": "seonWKim", "name": "software-factory", "path": ".", "base_branch": "main",
    "install_command": ["npm", "ci"], "test_command": ["npm", "test"],
    "check_commands": [["npm", "run", "typecheck"], ["npm", "test"]]
  },
  "intake_label": "factory",
  "branch_prefix": "factory/",
  "dials": { "spec_gate_min_tier": 1, "auto_merge_max_tier": 0 },
  "floors": [
    { "prefix": "prompts/", "tier": 3 },
    { "prefix": "factory.config.json", "tier": 3 },
    { "prefix": "src/core/", "tier": 3 },
    { "prefix": "src/impl/runner/", "tier": 4 },
    { "prefix": "src/impl/broker/", "tier": 4 },
    { "prefix": "src/impl/egress/", "tier": 4 },
    { "prefix": "src/impl/secrets/", "tier": 4 },
    { "prefix": "src/impl/auth/", "tier": 4 },
    { "prefix": "src/impl/github/app-credentials.ts", "tier": 4 },
    { "prefix": "src/impl/github/token-credentials.ts", "tier": 4 },
    { "prefix": ".claude/", "tier": 4 }
  ],
  "auth": "github",
  "cli_user": "github:69591622",
  "workers": 5,
  "max_workers": 10,
  "plugins": {
    "secrets": "env-file",
    "egress": "pattern",
    "broker": "github",
    "sandbox": "noop",
    "runner": "claude-code",
    "llm": "claude-cli",
    "source": ["github-issues", "local"],
    "storage": "fs",
    "capability": "bm25",
    "clock": "system",
    "updater": "git-worktree",
    "github_auth": "app",
    "test_database": "none",
    "network_probe": "http"
  },
  "models": { "cheap": "haiku", "standard": "sonnet", "strong": "opus" },
  "model_by": {
    "triage": "cheap",
    "implement": { "1": "standard", "2": "standard", "3": "strong", "4": "strong", "5": "strong" },
    "review": "standard",
    "resolve": { "1": "standard", "2": "standard", "3": "strong", "4": "strong", "5": "strong" },
    "retry_up": true
  },
  "max_loops": 3,
  "max_attempts": 3,
  "max_restart": 3,
  "retry_base_ms": 60000,
  "retry_max_ms": 1800000,
  "auth_pause_ms": 1800000,
  "max_diff_lines": 5000,
  "max_diff_files": 80,
  "lease_ms": 300000,
  "heartbeat_ms": 60000,
  "tick_ms": 2000,
  "poll_interval_ms": 30000,
  "run_timeout_ms": 5400000,
  "stall_ms": 300000,
  "probe_interval_ms": 600000,
  "max_coordination_cost": 2.5,
  "hotspot_weight": 3.0,
  "hotspot_paths": ["src/impl/store/sqlite/schema.ts", "src/impl/store/mysql/schema.ts", "src/core/controller.ts", "src/core/worker.ts", "docs/design.md", "SET_UP.md"],
  "mechanical_weight": 0.25,
  "mechanical_paths": ["src/impl/store/mysql/migrations.ts", "migrations/mysql/", "docs/design/", "docs/design.md", "docs/plugins.md", "docs/plugins/"],
  "path_companions": [
    { "when": "src/impl/store/sqlite/schema.ts", "also": ["migrations/mysql/", "src/impl/store/mysql/migrations.ts"] },
    { "when": "src/impl/store/mysql/schema.ts", "also": ["migrations/mysql/", "src/impl/store/mysql/migrations.ts"] },
    { "when": "docs/design.md", "also": ["docs/design/"] },
    { "when": "docs/plugins.md", "also": ["docs/plugins/"] }
  ],
  "state_dir": ".factory",
  "worktrees_dir": ".worktrees",
  "ui": { "port": 4310 },
  "stats": { "weights": { "none": 0, "minor": 1, "major": 3, "critical": 10 }, "min_sample": 10 },
  "agent_git_identity": { "name": "software-factory implementer", "email": "software-factory@users.noreply.github.com" }
}
