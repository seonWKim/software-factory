{
  "env": "local",
  "store": { "type": "mysql", "host": "localhost", "port": 3306, "database": "software_factory", "user": "factory" },
  "repo": { "owner": "seonWKim", "name": "software-factory", "path": ".", "base_branch": "main", "install_command": ["npm", "ci"], "test_command": ["npm", "test"] },
  "intake_label": "factory",
  "branch_prefix": "factory/",
  "dials": { "spec_gate_min_tier": 1, "auto_merge_max_tier": 0 },
  "floors": [
    { "prefix": "prompts/", "tier": 3 },
    { "prefix": "factory.config.json", "tier": 3 },
    { "prefix": "src/core/", "tier": 3 },
    { "prefix": "src/impl/runner/", "tier": 4 },
    { "prefix": "src/impl/broker/", "tier": 4 },
    { "prefix": "src/impl/egress/", "tier": 4 },
    { "prefix": "src/impl/secrets/", "tier": 4 },
    { "prefix": "src/impl/auth/", "tier": 4 },
    { "prefix": ".claude/", "tier": 4 }
  ],
  "auth": "github",
  "workers": 3,
  "plugins": {
    "secrets": "env-file",
    "egress": "pattern",
    "broker": "github",
    "sandbox": "noop",
    "runner": "claude-code",
    "llm": "claude-cli",
    "source": "github-issues",
    "storage": "fs",
    "capability": "list-all",
    "clock": "system",
    "updater": "git-worktree",
    "github_auth": "app"
  },
  "models": { "cheap": "haiku", "strong": "opus" },
  "max_loops": 3,
  "max_attempts": 3,
  "max_restart": 3,
  "retry_base_ms": 60000,
  "retry_max_ms": 1800000,
  "max_diff_lines": 1500,
  "max_diff_files": 40,
  "lease_ms": 300000,
  "heartbeat_ms": 60000,
  "tick_ms": 2000,
  "poll_interval_ms": 30000,
  "run_timeout_ms": 2700000,
  "state_dir": ".factory",
  "worktrees_dir": ".worktrees",
  "ui": { "port": 4310 },
  "stats": { "weights": { "none": 0, "minor": 1, "major": 3, "critical": 10 }, "min_sample": 10 },
  "agent_git_identity": { "name": "software-factory implementer", "email": "software-factory@users.noreply.github.com" }
}
